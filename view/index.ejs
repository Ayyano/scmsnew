async function saveStudent(event) {

    event.preventDefault();

    const student = {

        name:
            document
                .getElementById("studentName")
                .value
                .trim(),

        father_name:
            document
                .getElementById("fatherName")
                .value
                .trim(),

        class:
            document
                .getElementById("studentClass")
                .value,

        roll_number:
            document
                .getElementById("rollNumber")
                .value
                .trim(),

        phone:
            document
                .getElementById("studentPhone")
                .value
                .trim(),

        route:
            document
                .getElementById("studentRoute")
                .value
                .trim()
    };


    if (!student.name || !student.class) {

        showToast(
            "Student name and class are required."
        );

        return;
    }


    if (!supabaseClient) {

        student.id =
            Date.now();

        state.students.unshift(
            student
        );

        renderStudents();
        updateDashboard();

        closeStudentForm();

        showToast(
            "Student added in demo mode."
        );

        return;
    }


    try {

        const {
            data,
            error
        } = await supabaseClient
            .from("students")
            .insert(student)
            .select()
            .single();

        if (error) {
            throw error;
        }

        state.students.unshift(data);

        renderStudents();
        updateDashboard();

        closeStudentForm();

        showToast(
            "Student registered successfully."
        );

    } catch (error) {

        console.error(error);

        showToast(
            error.message ||
            "Unable to save student."
        );
    }
}


