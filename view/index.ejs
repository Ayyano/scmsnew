/* ================================================================
   FEES
================================================================ */

function renderFees() {

    const tbody =
        document.getElementById("feesTable");

    if (!tbody) return;

    if (!state.fees.length) {

        tbody.innerHTML = `
            <tr>
                <td colspan="7">
                    <div class="empty">
                        <i class="fa-solid fa-receipt"></i>
                        <p>No fee records available.</p>
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    tbody.innerHTML =
        state.fees.map(fee => {

            const total =
                Number(
                    fee.total ||
                    (
                        Number(fee.tuition || 0) +
                        Number(fee.transport || 0) +
                        Number(fee.late_fine || 0)
                    )
                );

            const paid =
                String(fee.status || "")
                    .toLowerCase() === "paid";

            return `
                <tr>

                    <td>
                        ${escapeHTML(
                            fee.voucher_no ||
                            fee.voucher_number ||
                            "-"
                        )}
                    </td>

                    <td>
                        ${escapeHTML(
                            fee.student_name ||
                            "-"
                        )}
                    </td>

                    <td>
                        PKR ${formatPKR(
                            fee.tuition
                        )}
                    </td>

                    <td>
                        PKR ${formatPKR(
                            fee.transport
                        )}
                    </td>

                    <td>
                        PKR ${formatPKR(
                            fee.late_fine
                        )}
                    </td>

                    <td>
                        <strong>
                            PKR ${formatPKR(total)}
                        </strong>
                    </td>

                    <td>
                        <span class="badge ${
                            paid
                                ? "badge-success"
                                : "badge-warning"
                        }">
                            ${paid ? "Paid" : "Pending"}
                        </span>
                    </td>

                </tr>
            `;

        }).join("");


    const collected =
        state.fees
            .filter(
                fee =>
                    String(fee.status)
                        .toLowerCase() === "paid"
            )
            .reduce(
                (sum, fee) =>
                    sum +
                    Number(
                        fee.total ||
                        Number(fee.tuition || 0) +
                        Number(fee.transport || 0) +
                        Number(fee.late_fine || 0)
                    ),
                0
            );


    const pending =
        state.fees
            .filter(
                fee =>
                    String(fee.status)
                        .toLowerCase() !== "paid"
            )
            .reduce(
                (sum, fee) =>
                    sum +
                    Number(
                        fee.total ||
                        Number(fee.tuition || 0) +
                        Number(fee.transport || 0) +
                        Number(fee.late_fine || 0)
                    ),
                0
            );


    document
        .getElementById("feeCollected")
        .textContent =
        "PKR " + formatPKR(collected);

    document
        .getElementById("feePending")
        .textContent =
        "PKR " + formatPKR(pending);
}


