<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>SCMS | KPK School Management System</title>

    <!-- Google Font -->
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    />

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Supabase -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>

        :root {
            --theme-dark: #0f5298;
            --theme-light: #1665b0;
            --bg-gray: #2f2f2f;
            --text-dark: #333;
            --text-muted: #777;
            --green: #7bb033;
            --orange: #f28c04;
            --teal: #38b9be;
            --red: #d90205;
            --white: #ffffff;
            --light-bg: #f4f7fb;
            --border: #e6e9ef;
            --shadow: 0 4px 15px rgba(0,0,0,0.1);
            --radius: 12px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Poppins", sans-serif;
            background: var(--light-bg);
            color: var(--text-dark);
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =========================================================
           LOGIN
        ========================================================= */

        #loginScreen {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background:
                linear-gradient(
                    135deg,
                    var(--theme-dark),
                    var(--theme-light)
                );
        }

        .login-box {
            width: 100%;
            max-width: 430px;
            background: #fff;
            padding: 38px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
        }

        .login-logo {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--theme-dark);
            color: #fff;
            font-size: 30px;
        }

        .login-box h1 {
            text-align: center;
            font-size: 25px;
            color: var(--theme-dark);
        }

        .login-box .subtitle {
            text-align: center;
            color: var(--text-muted);
            font-size: 13px;
            margin: 5px 0 28px;
        }

        .field {
            margin-bottom: 16px;
        }

        .field label {
            display: block;
            margin-bottom: 7px;
            font-size: 13px;
            font-weight: 600;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
        }

        .field input,
        .field select,
        .field textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 9px;
            outline: none;
            background: #fff;
            transition: .2s;
        }

        .input-wrapper input {
            padding-left: 42px;
        }

        .field input:focus,
        .field select:focus,
        .field textarea:focus {
            border-color: var(--theme-light);
            box-shadow: 0 0 0 3px rgba(22,101,176,.1);
        }

        .login-btn {
            width: 100%;
            border: none;
            border-radius: 9px;
            padding: 13px;
            color: #fff;
            background: var(--theme-dark);
            font-weight: 600;
            margin-top: 8px;
        }

        .login-btn:hover {
            background: var(--theme-light);
        }

        .login-note {
            text-align: center;
            margin-top: 18px;
            color: var(--text-muted);
            font-size: 11px;
        }

        .login-error {
            display: none;
            background: #fff1f1;
            color: var(--red);
            padding: 10px;
            border-radius: 8px;
            font-size: 12px;
            margin-bottom: 15px;
        }

        /* =========================================================
           APP
        ========================================================= */

        #app {
            display: none;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            background: #fff;
            border-right: 1px solid var(--border);
            z-index: 1000;
            overflow-y: auto;
        }

        .brand {
            height: 75px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 20px;
            border-bottom: 1px solid var(--border);
        }

        .brand-icon {
            width: 43px;
            height: 43px;
            border-radius: 11px;
            background: var(--theme-dark);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .brand-text strong {
            display: block;
            color: var(--theme-dark);
            font-size: 17px;
        }

        .brand-text span {
            font-size: 9px;
            color: var(--text-muted);
        }

        .menu {
            padding: 18px 12px;
        }

        .menu-title {
            font-size: 10px;
            font-weight: 600;
            color: #aaa;
            margin: 13px 10px 8px;
            text-transform: uppercase;
        }

        .menu-item {
            width: 100%;
            border: none;
            background: transparent;
            padding: 11px 12px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #666;
            font-size: 13px;
            text-align: left;
            margin-bottom: 3px;
        }

        .menu-item i {
            width: 19px;
            text-align: center;
        }

        .menu-item:hover,
        .menu-item.active {
            background: #edf5fc;
            color: var(--theme-dark);
            font-weight: 600;
        }

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }

        /* =========================================================
           TOPBAR
        ========================================================= */

        .topbar {
            height: 75px;
            background: #fff;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .page-title h2 {
            font-size: 20px;
        }

        .page-title span {
            font-size: 11px;
            color: var(--text-muted);
        }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-btn {
            width: 38px;
            height: 38px;
            border: 1px solid var(--border);
            background: #fff;
            border-radius: 9px;
            color: #777;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--theme-dark);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 13px;
            font-weight: 600;
        }

        .profile-info strong {
            display: block;
            font-size: 12px;
        }

        .profile-info span {
            font-size: 10px;
            color: var(--text-muted);
        }

        /* =========================================================
           CONTENT
        ========================================================= */

        .content {
            padding: 28px;
        }

        .view {
            display: none;
        }

        .view.active {
            display: block;
        }

        .welcome {
            background:
                linear-gradient(
                    110deg,
                    var(--theme-dark),
                    var(--theme-light)
                );
            color: #fff;
            padding: 25px;
            border-radius: var(--radius);
            margin-bottom: 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            overflow: hidden;
        }

        .welcome h2 {
            font-size: 22px;
            margin-bottom: 5px;
        }

        .welcome p {
            font-size: 12px;
            opacity: .85;
        }

        .welcome-icon {
            font-size: 75px;
            opacity: .12;
        }

        /* =========================================================
           CARDS
        ========================================================= */

        .stats-grid {
            display: grid;
            grid-template-columns:
                repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 22px;
        }

        .stat-card {
            background: #fff;
            padding: 19px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-card .stat-icon {
            width: 47px;
            height: 47px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
        }

        .blue {
            background: #eaf3fc;
            color: var(--theme-dark);
        }

        .green-bg {
            background: #eff8e7;
            color: var(--green);
        }

        .orange-bg {
            background: #fff3df;
            color: var(--orange);
        }

        .teal-bg {
            background: #e5f8f8;
            color: var(--teal);
        }

        .stat-card h3 {
            font-size: 23px;
        }

        .stat-card p {
            color: var(--text-muted);
            font-size: 11px;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns:
                1.6fr 1fr;
            gap: 20px;
        }

        .card {
            background: #fff;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 20px;
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .card-header h3 {
            font-size: 15px;
        }

        .card-header span {
            font-size: 11px;
            color: var(--text-muted);
        }

        canvas {
            max-height: 280px;
        }

        /* =========================================================
           TOOLBAR
        ========================================================= */

        .toolbar {
            background: #fff;
            padding: 15px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            margin-bottom: 18px;
            display: flex;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .toolbar-left,
        .toolbar-right {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .search {
            position: relative;
        }

        .search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #aaa;
        }

        .search input {
            width: 240px;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 10px 10px 36px;
            outline: none;
        }

        .btn {
            border: none;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 12px;
            font-weight: 600;
        }

        .btn-primary {
            background: var(--theme-dark);
            color: #fff;
        }

        .btn-green {
            background: var(--green);
            color: #fff;
        }

        .btn-orange {
            background: var(--orange);
            color: #fff;
        }

        .btn-light {
            background: #f1f4f7;
            color: #555;
        }

        /* =========================================================
           TABLE
        ========================================================= */

        .table-card {
            background: #fff;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        th,
        td {
            padding: 13px 15px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
            font-size: 12px;
        }

        th {
            background: #f8fafc;
            color: #666;
            font-size: 10px;
            text-transform: uppercase;
        }

        tr:hover td {
            background: #fafcff;
        }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 600;
        }

        .badge-success {
            background: #e9f6df;
            color: #5f9328;
        }

        .badge-warning {
            background: #fff0d8;
            color: #d77b00;
        }

        .badge-danger {
            background: #ffe4e4;
            color: #c40000;
        }

        .badge-info {
            background: #e5f3ff;
            color: var(--theme-dark);
        }

        /* =========================================================
           BOARD MODULE
        ========================================================= */

        .board-banner {
            background:
                linear-gradient(
                    110deg,
                    #0f5298,
                    #1e78be
                );
            color: #fff;
            border-radius: var(--radius);
            padding: 22px;
            margin-bottom: 20px;
        }

        .board-banner h2 {
            font-size: 19px;
        }

        .board-banner p {
            font-size: 11px;
            opacity: .85;
            margin-top: 4px;
        }

        .board-grid {
            display: grid;
            grid-template-columns:
                repeat(3, minmax(0,1fr));
            gap: 18px;
        }

        .board-card {
            background: #fff;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 20px;
        }

        .board-card i {
            color: var(--theme-dark);
            font-size: 25px;
            margin-bottom: 12px;
        }

        .board-card h3 {
            font-size: 14px;
            margin-bottom: 6px;
        }

        .board-card p {
            color: var(--text-muted);
            font-size: 11px;
            line-height: 1.7;
        }

        /* =========================================================
           FORMS
        ========================================================= */

        .form-grid {
            display: grid;
            grid-template-columns:
                repeat(2, minmax(0,1fr));
            gap: 16px;
        }

        .form-grid.three {
            grid-template-columns:
                repeat(3, minmax(0,1fr));
        }

        .form-actions {
            margin-top: 18px;
            display: flex;
            gap: 10px;
        }

        /* =========================================================
           EMPTY
        ========================================================= */

        .empty {
            text-align: center;
            padding: 50px 20px;
            color: var(--text-muted);
        }

        .empty i {
            font-size: 38px;
            margin-bottom: 12px;
            opacity: .5;
        }

        /* =========================================================
           TOAST
        ========================================================= */

        #toast {
            position: fixed;
            right: 25px;
            bottom: 25px;
            background: #222;
            color: #fff;
            padding: 13px 18px;
            border-radius: 9px;
            font-size: 12px;
            display: none;
            z-index: 9999;
            box-shadow: var(--shadow);
        }

        /* =========================================================
           MOBILE
        ========================================================= */

        .mobile-menu {
            display: none;
        }

        @media(max-width: 1100px) {

            .stats-grid {
                grid-template-columns:
                    repeat(2,1fr);
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }

            .board-grid {
                grid-template-columns:
                    repeat(2,1fr);
            }

        }

        @media(max-width: 800px) {

            .sidebar {
                transform: translateX(-100%);
                transition: .25s;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .main {
                margin-left: 0;
            }

            .mobile-menu {
                display: inline-flex;
                margin-right: 10px;
            }

            .content {
                padding: 17px;
            }

            .topbar {
                padding: 0 15px;
            }

            .profile-info {
                display: none;
            }

            .form-grid,
            .form-grid.three,
            .board-grid {
                grid-template-columns: 1fr;
            }

            .welcome-icon {
                display: none;
            }

        }

        @media(max-width: 500px) {

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .login-box {
                padding: 25px;
            }

            .search input {
                width: 100%;
            }

            .toolbar {
                align-items: stretch;
            }

            .toolbar-left,
            .toolbar-right {
                width: 100%;
            }

        }

        /* =========================================================
           PRINT
        ========================================================= */

        @media print {

            .sidebar,
            .topbar,
            .toolbar,
            .no-print {
                display: none !important;
            }

            .main {
                margin-left: 0;
            }

            .content {
                padding: 0;
            }

            body {
                background: #fff;
            }

            .card,
            .table-card {
                box-shadow: none;
                border: 1px solid #ddd;
            }

        }

    </style>
</head>

<body>

<!-- ============================================================
     LOGIN
============================================================ -->

<section id="loginScreen">

    <div class="login-box">

        <div class="login-logo">
            <i class="fa-solid fa-school"></i>
        </div>

        <h1>SCMS</h1>

        <div class="subtitle">
            KPK School Management System
        </div>

        <div
            id="loginError"
            class="login-error"
        ></div>

        <form id="loginForm">

            <div class="field">

                <label>Email</label>

                <div class="input-wrapper">

                    <i class="fa-solid fa-envelope"></i>

                    <input
                        id="email"
                        type="email"
                        placeholder="admin@school.edu.pk"
                        required
                    />

                </div>

            </div>

            <div class="field">

                <label>Password</label>

                <div class="input-wrapper">

                    <i class="fa-solid fa-lock"></i>

                    <input
                        id="password"
                        type="password"
                        placeholder="Enter password"
                        required
                    />

                </div>

            </div>

            <button
                class="login-btn"
                type="submit"
            >
                <i class="fa-solid fa-right-to-bracket"></i>
                Login
            </button>

        </form>

        <div class="login-note">
            Secured by Supabase Authentication
        </div>

    </div>

</section>


<!-- ============================================================
     APPLICATION
============================================================ -->

<div id="app">

    <!-- SIDEBAR -->

    <aside
        id="sidebar"
        class="sidebar"
    >

        <div class="brand">

            <div class="brand-icon">
                <i class="fa-solid fa-school"></i>
            </div>

            <div class="brand-text">
                <strong>SCMS</strong>
                <span>School Management System</span>
            </div>

        </div>


        <div class="menu">

            <div class="menu-title">
                Main
            </div>

            <button
                class="menu-item active"
                data-view="dashboard"
            >
                <i class="fa-solid fa-chart-pie"></i>
                Dashboard
            </button>

            <button
                class="menu-item"
                data-view="students"
            >
                <i class="fa-solid fa-user-graduate"></i>
                Students
            </button>

            <button
                class="menu-item"
                data-view="teachers"
            >
                <i class="fa-solid fa-chalkboard-user"></i>
                Teachers
            </button>

            <button
                class="menu-item"
                data-view="attendance"
            >
                <i class="fa-solid fa-calendar-check"></i>
                Attendance
            </button>


            <div class="menu-title">
                Academic
            </div>

            <button
                class="menu-item"
                data-view="classes"
            >
                <i class="fa-solid fa-school"></i>
                Classes
            </button>

            <button
                class="menu-item"
                data-view="marks"
            >
                <i class="fa-solid fa-file-pen"></i>
                Marks & Results
            </button>

            <button
                class="menu-item"
                data-view="board"
            >
                <i class="fa-solid fa-landmark"></i>
                BISE / KP Board
            </button>

            <button
                class="menu-item"
                data-view="timetable"
            >
                <i class="fa-solid fa-clock"></i>
                Timetable
            </button>


            <div class="menu-title">
                Finance
            </div>

            <button
                class="menu-item"
                data-view="fees"
            >
                <i class="fa-solid fa-money-bill-wave"></i>
                Fees
            </button>


            <div class="menu-title">
                Administration
            </div>

            <button
                class="menu-item"
                data-view="reports"
            >
                <i class="fa-solid fa-file-lines"></i>
                Reports
            </button>

            <button
                class="menu-item"
                data-view="certificates"
            >
                <i class="fa-solid fa-certificate"></i>
                Certificates
            </button>

            <button
                class="menu-item"
                data-view="notices"
            >
                <i class="fa-solid fa-bullhorn"></i>
                Notices
            </button>


            <div class="menu-title">
                System
            </div>

            <button
                class="menu-item"
                data-view="settings"
            >
                <i class="fa-solid fa-gear"></i>
                Settings
            </button>

            <button
                id="logoutBtn"
                class="menu-item"
            >
                <i class="fa-solid fa-right-from-bracket"></i>
                Logout
            </button>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <!-- TOPBAR -->

        <header class="topbar">

            <div class="page-title">

                <button
                    id="mobileMenu"
                    class="icon-btn mobile-menu"
                >
                    <i class="fa-solid fa-bars"></i>
                </button>

                <h2 id="currentTitle">
                    Dashboard
                </h2>

                <span>
                    Charsadda, Khyber Pakhtunkhwa
                </span>

            </div>


            <div class="top-actions">

                <button
                    class="icon-btn"
                    onclick="toggleLanguage()"
                    title="Language"
                >
                    <i class="fa-solid fa-language"></i>
                </button>

                <button
                    class="icon-btn"
                    onclick="showToast('No new notifications')"
                >
                    <i class="fa-regular fa-bell"></i>
                </button>

                <div class="profile">

                    <div
                        id="avatar"
                        class="avatar"
                    >
                        A
                    </div>

                    <div class="profile-info">

                        <strong id="userName">
                            Administrator
                        </strong>

                        <span id="userRole">
                            Admin
                        </span>

                    </div>

                </div>

            </div>

        </header>


        <!-- CONTENT -->

        <section class="content">


            <!-- =================================================
                 DASHBOARD
            ================================================= -->

            <div
                id="dashboard"
                class="view active"
            >

                <div class="welcome">

                    <div>

                        <h2>
                            Assalam-o-Alaikum,
                            <span id="welcomeName">
                                Administrator
                            </span>
                        </h2>

