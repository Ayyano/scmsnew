   MARKS
================================================================ */

function renderMarks() {

    const tbody =
        document.getElementById("marksTable");

    if (!tbody) return;

    if (!state.marks.length) {

        tbody.innerHTML = `
            <tr>
                <td colspan="7">
                    <div class="empty">
                        <i class="fa-solid fa-file-pen"></i>
