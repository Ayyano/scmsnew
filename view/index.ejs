                    mark.theory_marks ||
                    mark.theory ||
                    0
                );

            const practical =
                Number(
                    mark.practical_marks ||
                    mark.practical ||
                    0
                );

            const total =
                theory + practical;

            return `
                <tr>

                    <td>
                        ${
                            escapeHTML(
                                mark.student_name ||
                                mark.students?.name ||
                                "-"
                            )
                        }
                    </td>

                    <td>
                        ${
                            escapeHTML(
                                mark.class ||
                                mark.students?.class ||
                                "-"
                            )
                        }
                    </td>

                    <td>
                        ${
                            escapeHTML(
                                mark.exam_type ||
                                mark.exam ||
                                "-"
                            )
                        }
                    </td>

                    <td>
                        ${theory}
                    </td>

                    <td>
                        ${practical}
                    </td>

                    <td>
                        <strong>
                            ${total}
                        </strong>
                    </td>

                    <td>
                        <span class="badge badge-info">
                            ${calculateGrade(total)}
                        </span>
                    </td>

                </tr>
            `;

        }).join("");
}


function calculateGrade(percent) {

    if (percent >= 80) return "A1";
    if (percent >= 70) return "A";
    if (percent >= 60) return "B";
    if (percent >= 50) return "C";
    if (percent >= 40) return "D";

    return "F";
}


