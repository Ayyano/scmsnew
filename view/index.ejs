function toggleLanguage() {

    state.language =
        state.language === "en"
            ? "ur"
            : state.language === "ur"
                ? "ps"
                : "en";

    const names = {
        en: "English",
        ur: "اردو",
        ps: "پښتو"
    };

    showToast(
        "Language: " +
        names[state.language]
    );
}


/* ================================================================
   EVENTS
================================================================ */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        /*
        ------------------------------------------------------------
        Navigation
        ------------------------------------------------------------
        */

        document
            .querySelectorAll(
                ".menu-item[data-view]"
            )
            .forEach(item => {

                item.addEventListener(
                    "click",
                    () => {
                        openView(
                            item.dataset.view
                        );
                    }
                );

            });


        /*
        ------------------------------------------------------------
        Login
        ------------------------------------------------------------
        */

        document
            .getElementById("loginForm")
            .addEventListener(
                "submit",
                event => {

                    event.preventDefault();

                    login(
                        document
                            .getElementById("email")
                            .value
                            .trim(),

                        document
                            .getElementById("password")
                            .value
                    );

                }
            );


        /*
        ------------------------------------------------------------
        Logout
        ------------------------------------------------------------
        */

        document
            .getElementById("logoutBtn")
            .addEventListener(
                "click",
                logout
            );


        /*
        ------------------------------------------------------------
        Student Form
        ------------------------------------------------------------
        */

        document
            .getElementById("studentForm")
            .addEventListener(
                "submit",
                saveStudent
            );


        /*
        ------------------------------------------------------------
        Student Search
        ------------------------------------------------------------
        */

        document
            .getElementById("studentSearch")
            .addEventListener(
                "input",
                renderStudents
            );


        document
            .getElementById("studentClassFilter")
            .addEventListener(
                "change",
                renderStudents
            );


        /*
        ------------------------------------------------------------
        Attendance
        ------------------------------------------------------------
        */

        document
            .getElementById("attendanceClass")
            .addEventListener(
                "change",
                renderAttendanceList
            );


        /*
        ------------------------------------------------------------
        Mobile Menu
        ------------------------------------------------------------
        */

        document
            .getElementById("mobileMenu")
            .addEventListener(
                "click",
                () => {

                    document
                        .getElementById("sidebar")
                        .classList.toggle("open");

                }
            );


        /*
        ------------------------------------------------------------
        Settings
        ------------------------------------------------------------
        */

        document
            .getElementById("supabaseUrlInput")
            .value =
            localStorage.getItem(
                "scms_supabase_url"
            ) || "";

        document
            .getElementById("supabaseKeyInput")
            .value =
            localStorage.getItem(
                "scms_supabase_key"
            ) || "";


        /*
        ------------------------------------------------------------
        Initialize Supabase
        ------------------------------------------------------------
        */

        initializeSupabase();


        /*
        ------------------------------------------------------------
        Existing Session
        ------------------------------------------------------------
        */

        if (supabaseClient) {

            supabaseClient.auth
                .getSession()
                .then(
                    async ({
                        data
                    }) => {

                        if (
                            data &&
                            data.session
                        ) {

                            state.user =
                                data.session.user;

                            await loadProfile();

                            showApplication();
                        }

                    }
                );


            supabaseClient.auth
                .onAuthStateChange(
                    async (
                        event,
                        session
                    ) => {

                        if (
                            session &&
                            !state.user
                        ) {

                            state.user =
                                session.user;

                            await loadProfile();

                            showApplication();
                        }

                        if (
                            !session &&
                            event === "SIGNED_OUT"
                        ) {

                            state.user = null;

                        }

                    }
                );

        }


        /*
        ------------------------------------------------------------
        Defaults
        ------------------------------------------------------------
        */

        const date =
            document
                .getElementById("attendanceDate");

        if (date) {

            date.value =
                new Date()
                    .toISOString()
                    .split("T")[0];

        }

    }
);

</script>

