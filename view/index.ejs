function renderStudents() {

    const tbody =
        document.getElementById("studentsTable");

    if (!tbody) return;

    let students =
        [...state.students];

    const search =
        document
            .getElementById("studentSearch")
            ?.value
            .toLowerCase() || "";

    const classFilter =
        document
            .getElementById("studentClassFilter")
            ?.value || "";

    if (search) {

        students =
            students.filter(student =>
                String(student.name || "")
                    .toLowerCase()
                    .includes(search)
            );
    }

    if (classFilter) {

        students =
            students.filter(student =>
                String(student.class || "")
                    .toLowerCase() ===
                classFilter.toLowerCase()
            );
    }

    if (!students.length) {

        tbody.innerHTML = `
            <tr>
                <td colspan="7">
                    <div class="empty">
                        <i class="fa-solid fa-user-graduate"></i>
                        <p>No students found.</p>
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    tbody.innerHTML =
        students.map(student => {

            const status =
                student.bise_status ||
                student.board_status ||
                "Pending";

            return `
                <tr>

                    <td>
                        <strong>
                            ${escapeHTML(student.name)}
                        </strong>
                    </td>

                    <td>
                        ${escapeHTML(student.father_name || "-")}
                    </td>

                    <td>
                        ${escapeHTML(student.class || "-")}
                    </td>

                    <td>
                        ${escapeHTML(student.roll_number || "-")}
                    </td>

                    <td>
                        ${escapeHTML(student.route || "-")}
                    </td>

                    <td>
                        <span class="badge ${
                            status.toLowerCase() === "registered"
                                ? "badge-success"
                                : "badge-warning"
                        }">
                            ${escapeHTML(status)}
                        </span>
                    </td>

                    <td>

                        <button
                            class="btn btn-light"
                            onclick="viewStudent('${student.id}')"
                        >
                            <i class="fa-solid fa-eye"></i>
                        </button>

                    </td>

                </tr>
            `;

        }).join("");
}


