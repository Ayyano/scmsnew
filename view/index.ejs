async function saveAttendance() {

    const rows =
        document.querySelectorAll(
            ".attendance-row"
        );

    if (!rows.length) {

        showToast(
            "No attendance records to save."
        );

        return;
    }

    const date =
        document
            .getElementById("attendanceDate")
            .value;

    const records =
        [...rows].map(row => {

            return {
                student_id:
                    row.dataset.studentId,

                attendance_date:
                    date ||
                    new Date()
                        .toISOString()
                        .split("T")[0],

                status:
                    row.querySelector(
                        ".attendance-status"
                    ).value
            };

        });


    if (!supabaseClient) {

        showToast(
            "Attendance saved in demo mode."
        );

        return;
    }


    try {

        const {
            error
        } = await supabaseClient
            .from("attendance")
            .upsert(
                records,
                {
                    onConflict:
                        "student_id,attendance_date"
                }
            );

        if (error) {
            throw error;
        }

        showToast(
            "Attendance saved successfully."
        );

    } catch (error) {

        console.error(error);

        showToast(
            error.message ||
            "Unable to save attendance."
        );
    }
}


/* ================================================================
   DASHBOARD
================================================================ */

function updateDashboard() {

    const students =
        state.students || [];

    const teachers =
        state.teachers || [];

    document
        .getElementById("totalStudents")
        .textContent =
        students.length;

    document
        .getElementById("totalTeachers")
        .textContent =
        teachers.length;


    const class9 =
        students.filter(
            student =>
                String(student.class)
                    .toLowerCase() === "9th"
        ).length;

    const class10 =
        students.filter(
            student =>
                String(student.class)
                    .toLowerCase() === "10th"
        ).length;


    [
        "class9Count",
        "classes9",
        "classTable9"
    ].forEach(id => {

        const element =
            document.getElementById(id);

        if (element) {
            element.textContent =
                class9;
        }

    });


    [
        "class10Count",
        "classes10",
        "classTable10"
    ].forEach(id => {

        const element =
            document.getElementById(id);

        if (element) {
            element.textContent =
                class10;
        }

    });


    const feeTotal =
        state.fees.reduce(
            (sum, fee) =>
                sum +
                Number(
                    fee.total ||
                    Number(fee.tuition || 0) +
                    Number(fee.transport || 0) +
                    Number(fee.late_fine || 0)
                ),
            0
        );


    document
        .getElementById("monthlyFees")
        .textContent =
        "PKR " + formatPKR(feeTotal);


    renderRecentStudents();

    renderCharts();
}


function renderRecentStudents() {

    const tbody =
        document.getElementById(
            "recentStudents"
        );

    if (!tbody) return;

    const students =
        state.students.slice(0, 5);

    if (!students.length) {

        tbody.innerHTML = `
            <tr>
                <td colspan="4">
                    <div class="empty">
                        No students available.
                    </div>
                </td>
            </tr>
        `;

        return;
    }

    tbody.innerHTML =
        students.map(student => {

            return `
                <tr>

                    <td>
                        ${escapeHTML(
                            student.name
                        )}
                    </td>

                    <td>
                        ${escapeHTML(
                            student.class || "-"
                        )}
                    </td>

                    <td>
                        ${escapeHTML(
                            student.roll_number || "-"
                        )}
                    </td>

                    <td>
                        <span class="badge badge-success">
                            Active
                        </span>
                    </td>

                </tr>
            `;

        }).join("");
}


/* ================================================================
   CHARTS
================================================================ */

let admissionChart = null;
let feeChart = null;


function renderCharts() {

    const admissionCanvas =
        document.getElementById(
            "admissionChart"
        );

    const feeCanvas =
        document.getElementById(
            "feeChart"
        );

    if (!admissionCanvas ||
        !feeCanvas ||
        typeof Chart === "undefined") {

        return;
    }


    if (admissionChart) {
        admissionChart.destroy();
    }

    if (feeChart) {
        feeChart.destroy();
    }


    admissionChart =
        new Chart(
            admissionCanvas,
            {
                type: "line",

                data: {
                    labels: [
                        "Apr",
                        "May",
                        "Jun",
                        "Jul",
                        "Aug",
                        "Sep"
                    ],

                    datasets: [
                        {
                            label: "Admissions",

                            data: [
                                Math.round(
                                    state.students.length * .4
                                ),
                                Math.round(
                                    state.students.length * .55
                                ),
                                Math.round(
                                    state.students.length * .65
                                ),
                                Math.round(
                                    state.students.length * .75
                                ),
                                Math.round(
                                    state.students.length * .9
                                ),
                                state.students.length
                            ],

                            tension: .4,

                            borderWidth: 3,

                            fill: false
                        }
                    ]
                },

                options: {
                    responsive: true,

                    plugins: {
                        legend: {
                            display: false
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            }
        );


    const paid =
        state.fees
            .filter(
                fee =>
                    String(fee.status)
                        .toLowerCase() === "paid"
            )
            .reduce(
                (sum, fee) =>
                    sum +
                    Number(fee.total || 0),
                0
            );


    const pending =
        state.fees
            .filter(
                fee =>
                    String(fee.status)
                        .toLowerCase() !== "paid"
            )
            .reduce(
                (sum, fee) =>
                    sum +
                    Number(fee.total || 0),
                0
            );


    feeChart =
        new Chart(
            feeCanvas,
            {
                type: "doughnut",

                data: {

                    labels: [
                        "Paid",
                        "Pending"
                    ],

                    datasets: [
                        {
                            data: [
                                paid,
                                pending
                            ]
                        }
                    ]

                },

                options: {
                    responsive: true,

                    plugins: {
                        legend: {
                            position: "bottom"
                        }
                    }
                }
            }
        );
}


